---
// On-demand (prerender=false): reflects live submissions + confirmations.
// Zero-JS server-rendered HTML.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AttributeList from '../../components/AttributeList.astro';
import ReportVisitCta from '../../components/ReportVisitCta.astro';
import PhotoReportBanner from '../../components/PhotoReportBanner.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { categoryLabel, isCategory } from '../../lib/categories';
import { presentRepresentation, representationDefinition } from '../../lib/labeling';
import { contributionsOpen } from '../../lib/contributor';
import { getEvidenceForListing, getListing, getStatusesForListing } from '../../lib/repo';

const { id } = Astro.params;
const listing = id ? await getListing(id) : null;
// Representation tags, or null when provenance is unknown — an un-sourced flag
// must never render as an attestation (§4; migration 0012).
const owned = listing
  ? presentRepresentation('owned', listing.disabledOwned, listing.disabledOwnedSource, listing.representationNote)
  : null;
const led = listing
  ? presentRepresentation('led', listing.disabledLed, listing.disabledLedSource, listing.representationNote)
  : null;
if (!listing || listing.kind !== 'provider') Astro.response.status = 404;

const [statuses, evidence] = listing
  ? await Promise.all([getStatusesForListing(listing.id), getEvidenceForListing(listing.id)])
  : [[], new Map()];
const place = listing ? [listing.city, listing.region].filter(Boolean).join(', ') : '';
const prov = listing?.provider;
const justSubmitted = Astro.url.searchParams.get('submitted') === '1';
// "Report this photo" is gated on public contributions being open (§13).
const canReport = contributionsOpen();
const photoReportStatus = Astro.url.searchParams.get('photo_report');
---

{
  !listing || listing.kind !== 'provider' ? (
    <Base title="Provider not found">
      <h1>Provider not found</h1>
      <p>We couldn't find that provider. <a href="/providers/">Browse all providers</a>.</p>
    </Base>
  ) : (
    <Base title={listing.name} description={listing.summary ?? undefined}>
      {justSubmitted && (
        <p class="disclaimer" role="status" aria-atomic="true">
          Thanks — your listing was added. It starts as “self-reported / awaiting
          verification” until community visits confirm it.
        </p>
      )}
      <p><a href="/providers/">← All providers</a></p>
      <h1>{listing.name}</h1>
      {isCategory(listing.category) && (
        <p class="category-tag">
          <CategoryIcon category={listing.category} />
          <span>{categoryLabel(listing.category)}</span>
        </p>
      )}
      {place && <p class="listing-meta">{place}</p>}
      {listing.summary && <p>{listing.summary}</p>}

      <p class="ask-ahead-link">
        Booking an appointment?{' '}
        <a href={`/ask-ahead/${listing.id}/`}>Questions to ask before you go</a>{' '}
        — including what to ask about interpreters, equipment and staff training
        before the day.
      </p>

      <ReportVisitCta
        target="#accessibility"
        hasClaims={statuses.length > 0}
        reportHref={`/contribute/report/${listing.id}/`}
      />

      <h2>Ownership, leadership &amp; competence</h2>
      <p>
        No medical proof is ever required, or asked for. Each line says where the
        claim came from — the business telling us directly, or a certification we
        can point you at.
      </p>
      <ul>
        {prov && (
          <li>Disability-literate: {prov.disabilityLiterate ? 'Yes (self-attested)' : 'Not attested'}</li>
        )}
        {/* Representation renders ONLY with recorded provenance. An un-sourced
            flag reads "Not attested" — which is honest: we do not know who said
            it, so we do not repeat it (§4; migration 0012). */}
        <li>
          Disabled-owned ({representationDefinition('owned')}):
          {owned ? ` Yes (${owned.sourceLabel})` : ' Not attested'}
          {owned && <><br /><span class="attr-desc">{owned.provenance}</span></>}
        </li>
        <li>
          Disabled-led ({representationDefinition('led')}):
          {led ? ` Yes (${led.sourceLabel})` : ' Not attested'}
          {led && <><br /><span class="attr-desc">{led.provenance}</span></>}
        </li>
      </ul>

      <h2 id="accessibility">Accessibility & competence</h2>
      <p>
        Each item is validated separately — facility attributes are photo-backed,
        and behaviors come from first-person visits. No single overall score.
      </p>
      <PhotoReportBanner status={photoReportStatus} />
      <AttributeList
        statuses={statuses}
        evidence={evidence}
        canReport={canReport}
        returnTo={Astro.url.pathname}
      />

      <div class="disclaimer">
        <p>
          Self-attested and community-sourced. We do not individually verify
          providers at sign-up and can’t guarantee any experience or outcome.
          <a href="/about/privacy/">How we label trust.</a>
        </p>
      </div>
    </Base>
  )
}
